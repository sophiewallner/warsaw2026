\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mss_tikz}[Sophie Tikz Style für MSS]
% ============================================================
% TikZ
% ============================================================

\RequirePackage{tikz}
\RequirePackage{sansmath}

\usetikzlibrary{
    backgrounds,
    calc,
    fit,
    graphs,
    petri,
    positioning
}


% ============================================================
% Allgemeine Styles
% ============================================================
\tikzset{
    node distance=1.5cm and 2.0cm,
    >=latex,
    font=\sf\bfseries\sansmath,
}

\tikzgraphsset{
    every graph/.style = {use existing nodes}
}

% Standard-Box
\tikzset{
    box/.style={
            rectangle,
            draw,
            line width=1.1pt,
            minimum height=1.5cm,
            minimum width=2.8cm,
            align=center
        }
}

% Pfeil
\tikzset{
    pfeil/.style={
            ->,
            line width=1.1pt
        }
}

% Textfeld
\tikzset{
    textfeld/.style={
            align=center,
            minimum height=0.5cm,
            minimum width=1.5cm
        }
}
% Kleiner Punkt
\tikzset{
    dot/.style={
            circle,
            fill,
            inner sep=0.2mm,
            outer sep=0.2mm
        }
}

% ============================================================
% Petri-Netz-Styles
% ============================================================

% Stelle (Place)
\tikzset{
    place/.style={
            circle,
            line width=1.1pt,
            draw=black,
            minimum size=6mm
        }
}

% Transition
\tikzset{
    transition/.style={
            rectangle,
            line width=1.1pt,
            draw=black,
            minimum size=6mm
        }
}

% Markierung
\tikzset{
    marking/.style={
            align=center,
            inner sep=1pt
        }
}

% Initial-Markierungshilfe
\tikzset{
    initial/.style={
            draw=none
        }
}
% ============================================================
% Modular State Space-Styles
% ============================================================
% Modul
\tikzset{
    module/.style={
            rectangle,
            fill=gray!25,
            line width=1.1pt,
            inner sep=10pt
        }
}
\tikzset{
    module label/.style={text=gray!90}
}
% Synchronisation
\tikzset{
    synchronization/.style={
            draw,
            dashed,
            rounded corners,
            inner sep=6pt
        }
}

% Segment
\tikzset{
    segment/.style={
            rectangle,
            draw,
            dashed,
            rounded corners=3mm,
            minimum height=1.5cm,
            minimum width=2.8cm
        }
}

% Generator
\tikzset{
    generator/.style={
            rectangle,
            draw,
            fill=gray!5,
            dashed,
            rounded corners=3mm,
            minimum height=1cm,
            minimum width=2.8cm
        }
}
% ============================================================
% Textgestaltung
% ============================================================
\definecolor{greyred}{RGB}{187,144,158}
\definecolor{greyblue}{RGB}{144,158,187}
\definecolor{greygreen}{RGB}{144,187,158}